# Copy to .env.local and fill in. Never commit real keys.

# Dashboard database (production unless you point it elsewhere).
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Browser tests (Playwright). Set both to run the suite against a database copy
# instead of production. Read by playwright.config.ts, which passes them to the dev
# server it spawns; put them in your shell, not .env.local, so `npm run dev` is unchanged.
# E2E_SUPABASE_URL=https://<copy-project-ref>.supabase.co
# E2E_SUPABASE_ANON_KEY=
# E2E_WORKERS=2
# E2E_PORT=3111

# Portal accounts (issue 248). Unset means portal accounts and public.open_module on every
# dashboard load. "command" keeps the old open dashboard and command.* sign-in until the 1.6
# lockdown and migration 20261118200000 are applied.
# DASHBOARD_ACCOUNTS=command
# The portal's address, for "Back to the portal" and sign-in (https only).
# NEXT_PUBLIC_PORTAL_URL=https://app.intofocus.ai
# Shared parent domain for the Supabase session cookie, so a portal sign-in carries over.
# NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN=.intofocus.ai
