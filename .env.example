# Copy to .env.local and fill in. Never commit real keys.

# Dashboard database (production unless you point it elsewhere).
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Manage users (/settings/users): invites and removals run on the server with the service
# role key. Server only: no NEXT_PUBLIC_ prefix. On Netlify set it under Site configuration >
# Environment variables, scoped to Functions/runtime. Without it the page says it is not set up.
# SUPABASE_SERVICE_ROLE_KEY=

# Browser tests (Playwright). Set both to run the suite against a database copy
# instead of production. Read by playwright.config.ts, which passes them to the dev
# server it spawns; put them in your shell, not .env.local, so `npm run dev` is unchanged.
# E2E_SUPABASE_URL=https://<copy-project-ref>.supabase.co
# E2E_SUPABASE_ANON_KEY=
# E2E_WORKERS=2
# E2E_PORT=3111
